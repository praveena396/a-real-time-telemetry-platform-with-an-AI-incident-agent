# Copy to .env and adjust. docker compose reads it automatically.
SIM_DEVICES=20
SIM_RATE_HZ=10
SIM_FAULT_SCALE=0.02        # 1.0 = benchmark fault rates; lower = calmer live demo
DETECTOR=hybrid             # zscore | ewma | cusum | hybrid
GEMINI_API_KEY=             # empty = built-in heuristic agent
GEMINI_MODEL=gemini-2.5-flash
